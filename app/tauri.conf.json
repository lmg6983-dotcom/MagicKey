{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MagicKey",
  "version": "0.4.8",
  "identifier": "com.lmg6983.magickey",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MagicKey",
        "width": 680,
        "height": 132,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "어디서든 Ctrl+Alt+Space 로 여는 만능 입력창",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5NkMyMkMyNEM4RDI1OTgKUldTWUpZMU13aUpzcWFtbWp5VlArVVUydC80ckgrcTZaaVpoZnBTbFJaWnJvOVkwQno0L3VDZjIK",
      "endpoints": [
        "https://github.com/lmg6983-dotcom/MagicKey/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
